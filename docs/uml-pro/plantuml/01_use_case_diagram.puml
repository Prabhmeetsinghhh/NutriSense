@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BorderColor #1F4E79
  ArrowColor #1F4E79
  BackgroundColor #F9FCFF
}
skinparam actor {
  BorderColor #1F4E79
  BackgroundColor #EAF3FF
}

title NutriSense - Use Case Diagram

actor User
actor Admin as Admin
actor "Recommendation Engine" as Engine

rectangle "NutriSense System" {
  usecase "UC1 Register/Login" as UC1
  usecase "UC2 Enter User Profile" as UC2
  usecase "UC3 Validate Inputs" as UC3
  usecase "UC4 Calculate BMI/TDEE" as UC4
  usecase "UC5 Generate Diet Plan" as UC5
  usecase "UC6 Generate Fitness Plan" as UC6
  usecase "UC7 Apply Budget & Diet Constraints" as UC7
  usecase "UC8 View Personalized Plan" as UC8
  usecase "UC9 Download/Save Plan" as UC9
  usecase "UC10 Manage Food Dataset" as UC10
}

User --> UC1
User --> UC2
User --> UC8
User --> UC9

UC2 --> UC3 : <<include>>
UC8 --> UC5 : <<include>>
UC8 --> UC6 : <<include>>
UC5 --> UC4 : <<include>>
UC5 --> UC7 : <<include>>
UC6 --> UC4 : <<include>>

Engine --> UC4
Engine --> UC5
Engine --> UC6

Admin --> UC10
UC5 ..> UC10 : <<extend>>\n(if dataset updated)

@enduml