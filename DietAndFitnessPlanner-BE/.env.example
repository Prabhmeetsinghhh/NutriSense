APP_ENV=development

# Set this to your real MongoDB or Atlas connection string for durable storage.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=diet_fitness_planner

# Keep mock fallback off in production. It is safe for local development only.
MONGODB_USE_MOCK=false
MONGODB_ALLOW_MOCK_FALLBACK=true

# Comma-separated list of allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional override for trained model artifacts.
ML_MODEL_DIR=DietAndFitnessPlanner-BE/models